{
  "name": "ytx",
  "version": "0.1.0",
  "description": "A CLI tool for downloading YouTube videos using yt-dlp",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:hot": "bun --watch --hot run src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "xlink": "bun unlink && bun link"
  },
  "bin": {
    "ytx": "./src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "@types/cli-progress": "^3.11.6",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "ora": "^9.4.0"
  }
}
